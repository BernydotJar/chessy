{
  "name": "glasschess",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A beautiful, free chess platform with glassmorphism design",
  "author": "GlassChess Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "chess.js": "^1.0.0-beta.6",
    "react-chessboard": "^4.4.0",
    "zustand": "^4.4.7",
    "clsx": "^2.0.0",
    "lucide-react": "^0.294.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^1.0.4"
  },
  "keywords": [
    "chess",
    "react",
    "typescript",
    "glassmorphism",
    "free",
    "game",
    "multiplayer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/glasschess.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/glasschess/issues"
  },
  "homepage": "https://glasschess.vercel.app"
}
