{
  "name": "chessy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Local-first chess academy, verified challenges and Stockfish practice",
  "author": "Chessy contributors",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/browser-verify.cjs",
    "verify": "npm run lint && npm test -- --run && npm run build",
    "test:pwa": "node scripts/pwa-verify.cjs"
  },
  "dependencies": {
    "chess.js": "^1.0.0-beta.6",
    "clsx": "^2.0.0",
    "i18next": "^25.8.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "1.41.0",
    "react": "19.2.8",
    "react-chessboard": "5.12.1",
    "react-dom": "19.2.8",
    "react-i18next": "^16.5.3",
    "stockfish.js": "^10.0.2",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.58.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "keywords": [
    "chess",
    "academy",
    "challenges",
    "react",
    "typescript",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BernydotJar/chessy.git"
  },
  "bugs": {
    "url": "https://github.com/BernydotJar/chessy/issues"
  },
  "homepage": "https://bernydotjar.github.io/chessy/",
  "engines": {
    "node": ">=22.12.0"
  }
}
