# Firebase web client configuration. These values identify a Firebase web app;
# never put service-account credentials or private keys in VITE_* variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# Local development only, for example http://127.0.0.1:9099
VITE_FIREBASE_AUTH_EMULATOR_URL=

VITE_FIREBASE_MEASUREMENT_ID=
# Local Firestore rules testing only; never set in production builds.
VITE_FIREBASE_FIRESTORE_EMULATOR_URL=

# Firebase Cloud Functions / App Check. App Check uses reCAPTCHA Enterprise site key (public identifier).
VITE_FIREBASE_APP_CHECK_SITE_KEY=
# Emulator only: http://127.0.0.1:19649
VITE_FIREBASE_FUNCTIONS_EMULATOR_URL=

# Published, reviewed privacy notice URL (https) for this private room feature.
VITE_CHESSY_ROOM_PRIVACY_URL=
# Server-only: CHESSY_ROOM_PRIVACY_NOTICE_URL and CHESSY_ROOM_PRIVACY_VERSION in Functions env.
