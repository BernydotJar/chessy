# Firebase web client configuration. These values identify a Firebase web app;
# never put service-account credentials or private keys in VITE_* variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# Local development only, for example http://127.0.0.1:9099
VITE_FIREBASE_AUTH_EMULATOR_URL=
