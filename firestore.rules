rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validProgressDocument(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'schemaVersion', 'ownerUid', 'progressVersion',
          'solved', 'lessons', 'days', 'mistakes', 'review', 'updatedAt'
        ])
        && d.schemaVersion == 1
        && d.ownerUid == uid
        && d.progressVersion == 2
        && d.solved is list && d.solved.size() <= 224
        && d.lessons is list && d.lessons.size() <= 64
        && d.days is list && d.days.size() <= 10000
        && d.mistakes is int && d.mistakes >= 0 && d.mistakes <= 1000000
        && d.review is list && d.review.size() <= 224
        && d.updatedAt == request.time;
    }

    function isCoach() {
      return request.auth != null && request.auth.token.email_verified == true
        && (request.auth.token.chessyRole == 'coach' || request.auth.token.chessyRole == 'admin');
    }

    function validLiveUrl(url) {
      return url is string && url.size() <= 500 &&
        (url.matches('^https://meet[.]google[.]com/[A-Za-z0-9/_?=&%-]+$')
          || url.matches('^https://teams[.]microsoft[.]com/[A-Za-z0-9/_?=&%-]+$')
          || url.matches('^https://([A-Za-z0-9-]+[.])?zoom[.]us/[A-Za-z0-9/_?=&%-]+$'));
    }

    function isEnrolled(sessionId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/coachEnrollments/$(sessionId)/members/$(request.auth.uid));
    }

    function validMeetingSecret(uid, sessionId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['schemaVersion', 'ownerUid', 'meetingUrl', 'updatedAt'])
        && d.keys().hasAll(['schemaVersion', 'ownerUid', 'meetingUrl', 'updatedAt'])
        && d.schemaVersion == 1
        && d.ownerUid == uid
        && validLiveUrl(d.meetingUrl)
        && d.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/coachSessions/$(sessionId)).data.ownerUid == uid
        && getAfter(/databases/$(database)/documents/coachSessions/$(sessionId)).data.kind == 'live';
    }

    function validCoachSession(uid, sessionId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'schemaVersion', 'ownerUid', 'kind', 'status', 'title', 'description',
          'language', 'startsAt', 'meetingUrl', 'videoPath', 'relatedLessonId',
          'createdAt', 'updatedAt'
        ])
        && d.keys().hasAll([
          'schemaVersion', 'ownerUid', 'kind', 'status', 'title', 'description',
          'language', 'startsAt', 'meetingUrl', 'videoPath', 'relatedLessonId',
          'createdAt', 'updatedAt'
        ])
        && d.schemaVersion == 1
        && d.ownerUid == uid
        && (d.kind == 'live' || d.kind == 'recorded')
        && (d.status == 'draft' || d.status == 'published')
        && d.title is string && d.title.size() >= 6 && d.title.size() <= 100
        && d.description is string && d.description.size() <= 500
        && (d.language == 'es' || d.language == 'en' || d.language == 'pt')
        && (d.relatedLessonId == null ||
          (d.relatedLessonId is string && d.relatedLessonId.size() <= 60))
        && d.createdAt is timestamp
        && d.updatedAt == request.time
        && (d.kind != 'live' ||
          (d.videoPath == null
            && (d.startsAt == null ||
              (d.startsAt is string && d.startsAt.size() == 24))
            && d.meetingUrl == null
            && (d.status != 'published' ||
              (d.startsAt is string
                && existsAfter(/databases/$(database)/documents/coachSessionSecrets/$(sessionId))
                && validLiveUrl(getAfter(
                  /databases/$(database)/documents/coachSessionSecrets/$(sessionId)
                ).data.meetingUrl)))))
        && (d.kind != 'recorded' ||
          (d.meetingUrl == null && d.startsAt == null &&
            (d.videoPath == null ||
              d.videoPath == 'coach-recordings/' + uid + '/' + sessionId + '/video.mp4')
            && (d.status != 'published' || d.videoPath is string)));
    }

    match /users/{uid}/progress/{documentId} {
      allow read: if documentId == 'current' && isOwner(uid);
      allow create, update: if documentId == 'current' && isOwner(uid) && validProgressDocument(uid);
      allow delete: if documentId == 'current' && isOwner(uid);
    }

    // A public published catalog, but a private writer workspace. No client grants coach roles.
    match /coachSessions/{sessionId} {
      // Public queries constrain status==published. All new writes are checked
      // to guarantee meetingUrl is null; verify legacy records before rollout.
      allow get, list: if resource.data.status == 'published' ||
        (isCoach() && resource.data.ownerUid == request.auth.uid);
      allow create: if isCoach() && validCoachSession(request.auth.uid, sessionId)
        && request.resource.data.createdAt == request.time;
      allow update: if isCoach() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && validCoachSession(request.auth.uid, sessionId);
      allow delete: if isCoach() && resource.data.ownerUid == request.auth.uid;
    }

    // Public metadata has no private meeting URLs. No collection enumeration.
    match /coachSessionSecrets/{sessionId} {
      allow get: if request.auth != null && (
        (isCoach() && resource.data.ownerUid == request.auth.uid) ||
        (get(/databases/$(database)/documents/coachSessions/$(sessionId)).data.status == 'published'
         && get(/databases/$(database)/documents/coachSessions/$(sessionId)).data.kind == 'live'
         && get(/databases/$(database)/documents/coachSessions/$(sessionId)).data.ownerUid == resource.data.ownerUid
         && isEnrolled(sessionId)));
      allow list: if false;
      allow create: if isCoach() && validMeetingSecret(request.auth.uid, sessionId);
      allow update: if isCoach() && resource.data.ownerUid == request.auth.uid
        && validMeetingSecret(request.auth.uid, sessionId);
      allow delete: if isCoach() && resource.data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/coachSessions/$(sessionId)).data.kind != 'live';
    }

    // Only trusted backend code using Firebase Admin SDK provisions enrollments.
    match /coachEnrollments/{sessionId}/members/{uid} {
      allow get: if isOwner(uid);
      allow list, create, update, delete: if false;
    }


    // Rooms are private. A learner gains membership only through an unpredictable,
    // short-lived invitation AND an atomic self-owned enrollment index.
    function verifiedIdentity() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function roomRef(roomId) {
      return /databases/$(database)/documents/learningRooms/$(roomId);
    }
    function memberRef(roomId, uid) {
      return /databases/$(database)/documents/learningRooms/$(roomId)/members/$(uid);
    }
    function myRoomRef(uid, roomId) {
      return /databases/$(database)/documents/userRooms/$(uid)/rooms/$(roomId);
    }
    function ownsRoom(roomId) {
      return isCoach() && exists(roomRef(roomId)) &&
        get(roomRef(roomId)).data.ownerUid == request.auth.uid;
    }
    function isRoomMember(roomId) {
      return request.auth != null && exists(memberRef(roomId, request.auth.uid));
    }
    function mayReadRoom(roomId) {
      return ownsRoom(roomId) || isRoomMember(roomId);
    }
    function supportedAge(age) {
      return age == '6-9' || age == '10-12' || age == '13-17' || age == 'adult';
    }
    function ageAllowed(roomId, age) {
      let audience = get(roomRef(roomId)).data.audience;
      return audience == 'mixed' || (age == 'adult' && audience == 'adults') ||
        (age != 'adult' && audience == 'children');
    }
    function validRoomWrite(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['schemaVersion','ownerUid','title','audience','language','status','createdAt','updatedAt'])
        && d.keys().hasAll(['schemaVersion','ownerUid','title','audience','language','status','createdAt','updatedAt'])
        && d.schemaVersion == 1 && d.ownerUid == uid
        && d.title is string && d.title.size() >= 6 && d.title.size() <= 80
        && (d.audience == 'children' || d.audience == 'adults' || d.audience == 'mixed')
        && (d.language == 'es' || d.language == 'en' || d.language == 'pt')
        && (d.status == 'active' || d.status == 'closed')
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    function validInviteWrite(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['schemaVersion','roomId','ownerUid','roomTitle','audience','createdAt','expiresAt'])
        && d.keys().hasAll(['schemaVersion','roomId','ownerUid','roomTitle','audience','createdAt','expiresAt'])
        && d.schemaVersion == 1 && d.ownerUid == uid
        && d.roomId is string && d.roomId.size() == 20
        && ownsRoom(d.roomId) && get(roomRef(d.roomId)).data.status == 'active'
        && d.roomTitle == get(roomRef(d.roomId)).data.title
        && d.audience == get(roomRef(d.roomId)).data.audience
        && d.createdAt == request.time
        && d.expiresAt is timestamp
        && d.expiresAt > request.time && d.expiresAt <= request.time + duration.value(8,'d');
    }
    function validEnrollmentInvite(roomId, inviteId) {
      return inviteId is string && inviteId.size() == 20
        && exists(/databases/$(database)/documents/roomInvites/$(inviteId))
        && get(/databases/$(database)/documents/roomInvites/$(inviteId)).data.roomId == roomId
        && get(/databases/$(database)/documents/roomInvites/$(inviteId)).data.ownerUid == get(roomRef(roomId)).data.ownerUid
        && get(/databases/$(database)/documents/roomInvites/$(inviteId)).data.expiresAt > request.time;
    }
    function validEnrollment(roomId, uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['schemaVersion','uid','roomId','inviteId','ageBand','guardianConfirmed','joinedAt'])
        && d.keys().hasAll(['schemaVersion','uid','roomId','inviteId','ageBand','guardianConfirmed','joinedAt'])
        && d.schemaVersion == 1 && d.uid == uid && d.roomId == roomId
        && d.joinedAt == request.time
        && supportedAge(d.ageBand)
        && d.guardianConfirmed is bool && d.guardianConfirmed == (d.ageBand != 'adult')
        && exists(roomRef(roomId)) && get(roomRef(roomId)).data.status == 'active'
        && ageAllowed(roomId,d.ageBand) && validEnrollmentInvite(roomId,d.inviteId);
    }
    function validBoardData() {
      let d = request.resource.data;
      return d.keys().hasOnly(['fen','initialFen','moves','revision','locked','updatedAt'])
        && d.keys().hasAll(['fen','initialFen','moves','revision','locked','updatedAt'])
        && d.fen is string && d.fen.size() >= 15 && d.fen.size() <= 120
        && d.initialFen is string && d.initialFen.size() >= 15 && d.initialFen.size() <= 120
        && d.moves is list && d.moves.size() <= 500
        && d.revision is int && d.revision >= 0 && d.revision <= 100000
        && d.locked is bool && d.updatedAt == request.time;
    }
    function validDiagnosticWrite(roomId, uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['schemaVersion','uid','roomId','ageBand','guardianConfirmed','goal','answers','submittedAt'])
        && d.keys().hasAll(['schemaVersion','uid','roomId','ageBand','guardianConfirmed','goal','answers','submittedAt'])
        && d.schemaVersion == 1 && d.uid == uid && d.roomId == roomId
        && d.ageBand == get(memberRef(roomId,uid)).data.ageBand
        && d.guardianConfirmed == get(memberRef(roomId,uid)).data.guardianConfirmed
        && (d.goal == 'discover' || d.goal == 'family' || d.goal == 'compete')
        && d.answers is map
        && d.answers.keys().hasOnly(['q1','q2','q3','q4','q5'])
        && d.answers.keys().hasAll(['q1','q2','q3','q4','q5'])
        && (d.answers.q1 == 'a' || d.answers.q1 == 'b' || d.answers.q1 == 'c')
        && (d.answers.q2 == 'a' || d.answers.q2 == 'b' || d.answers.q2 == 'c')
        && (d.answers.q3 == 'a' || d.answers.q3 == 'b' || d.answers.q3 == 'c')
        && (d.answers.q4 == 'a' || d.answers.q4 == 'b' || d.answers.q4 == 'c')
        && (d.answers.q5 == 'a' || d.answers.q5 == 'b' || d.answers.q5 == 'c')
        && d.submittedAt == request.time;
    }

    match /learningRooms/{roomId} {
      allow get: if mayReadRoom(roomId);
      // Owners retain read access for account-data cleanup even if their coach role is later revoked.
      allow list: if verifiedIdentity() && resource.data.ownerUid == request.auth.uid;
      allow create: if isCoach() && validRoomWrite(request.auth.uid)
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time;
      allow update: if ownsRoom(roomId) && validRoomWrite(request.auth.uid)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && resource.data.status == 'active' && request.resource.data.status == 'closed';
      allow delete: if false;

      match /board/{boardId} {
        allow get: if boardId == 'current' && mayReadRoom(roomId);
        allow list: if false;
        allow create: if boardId == 'current' && isCoach()
          && getAfter(roomRef(roomId)).data.ownerUid == request.auth.uid
          && validBoardData() && request.resource.data.revision == 0
          && request.resource.data.moves.size() == 0;
        allow update: if boardId == 'current' && ownsRoom(roomId)
          && get(roomRef(roomId)).data.status == 'active'
          && validBoardData() && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if false;
      }
      match /members/{uid} {
        allow get: if isOwner(uid) || ownsRoom(roomId);
        allow list: if ownsRoom(roomId);
        allow create: if verifiedIdentity() && isOwner(uid)
          && validEnrollment(roomId,uid)
          && getAfter(myRoomRef(uid,roomId)).data == request.resource.data;
        allow update: if false;
        allow delete: if isOwner(uid) || ownsRoom(roomId);
      }
      match /diagnostics/{uid} {
        allow get: if isOwner(uid) || ownsRoom(roomId);
        allow list: if ownsRoom(roomId);
        allow create: if verifiedIdentity() && isOwner(uid) && isRoomMember(roomId)
          && get(roomRef(roomId)).data.status == 'active'
          && validDiagnosticWrite(roomId,uid);
        allow update: if false;
        allow delete: if isOwner(uid) || ownsRoom(roomId);
      }
    }

    match /roomInvites/{inviteId} {
      // An unguessable 20-character ID is the bearer capability; never list invitations as a learner.
      allow get: if verifiedIdentity() && resource.data.expiresAt > request.time
        && exists(roomRef(resource.data.roomId))
        && get(roomRef(resource.data.roomId)).data.status == 'active';
      allow list: if isCoach() && resource.data.ownerUid == request.auth.uid;
      allow create: if isCoach() && inviteId.size() == 20 && validInviteWrite(request.auth.uid);
      allow update: if false;
      allow delete: if isCoach() && resource.data.ownerUid == request.auth.uid;
    }

    match /userRooms/{uid}/rooms/{roomId} {
      allow get, list: if isOwner(uid);
      allow create: if verifiedIdentity() && isOwner(uid) &&
        validEnrollment(roomId,uid)
        && getAfter(memberRef(roomId,uid)).data == request.resource.data;
      allow update: if false;
      allow delete: if (isOwner(uid) || ownsRoom(roomId))
        && !existsAfter(memberRef(roomId,uid));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
